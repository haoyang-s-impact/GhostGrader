{
  "manifest_version": 3,
  "name": "Ghost Grader",
  "version": "0.1.0",
  "description": "Rubric alignment, consistency alerts, and one-click feedback beside your LMS grader.",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:8787/*", "http://127.0.0.1:8787/*"],
  "content_scripts": [
    {
      "matches": ["http://localhost:5173/*", "http://127.0.0.1:5173/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
