{
  "manifest_version": 3,
  "name": "Ghost Grader for Moodle",
  "version": "0.2.0",
  "description": "Rubric-referenced grade suggestions, rubric checks and cross-student consistency alerts inside Moodle's quiz manual grading page.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8787/*",
    "http://127.0.0.1:8787/*",
    "http://localhost:*/mod/quiz/report.php*",
    "https://*/mod/quiz/report.php*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "http://localhost/mod/quiz/report.php*",
        "http://localhost:*/mod/quiz/report.php*",
        "https://*/mod/quiz/report.php*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page-bridge.js"
      ],
      "matches": [
        "http://localhost/*",
        "http://localhost:*/*",
        "https://*/*"
      ]
    }
  ]
}
