# Copy to .env. Provider chain, in order, for whichever keys are set:
#   OPENROUTER_API_KEY -> OPENAI_API_KEY -> ANTHROPIC_API_KEY
# The first is primary; the rest are fallbacks when a call fails. None set: mock analyzer.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=            # default openai/gpt-4o-mini
OPENAI_API_KEY=
OPENAI_MODEL=                # default gpt-4o-mini
ANTHROPIC_API_KEY=
# Force the mock analyzer even when keys are present (the tests do this).
GG_MOCK=
PORT=8787
# Where the JSON store lives. Default: apps/api/data/ghost-grader.json
GG_DATA_PATH=
