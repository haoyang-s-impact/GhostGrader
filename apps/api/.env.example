# Copy to .env. Provider selection: OPENROUTER_API_KEY wins, then ANTHROPIC_API_KEY, else the mock analyzer.
OPENROUTER_API_KEY=
# Any OpenAI-compatible model id on OpenRouter. Default: openai/gpt-4o-mini
OPENROUTER_MODEL=
ANTHROPIC_API_KEY=
# Force the mock analyzer even when a key is present (the tests do this).
GG_MOCK=
PORT=8787
# Where the JSON store lives. Default: apps/api/data/ghost-grader.json
GG_DATA_PATH=
