# Copy to .env. Provider chain, in order, for whichever keys are set:
#   OPENROUTER_API_KEY -> OPENAI_API_KEY -> ANTHROPIC_API_KEY
# The first is primary; the rest are fallbacks when a call fails. None set: mock analyzer.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=            # default openai/gpt-4o-mini
OPENAI_API_KEY=
OPENAI_MODEL=                # default gpt-4o-mini
ANTHROPIC_API_KEY=
# Force the mock analyzer even when keys are present (the tests do this).
GG_MOCK=
PORT=8787
# Where the SQLite database lives. Default: apps/api/data/ghost-grader.sqlite
GG_DB_PATH=
# LMS to pull answers from and push grades to. Unset: none; the seeded demo answers are used.
# canvas is a stub until its adapter is implemented.
GG_LMS=
# The LMS API base URL.
GG_LMS_BASE_URL=
# Bearer token sent to the LMS.
GG_LMS_TOKEN=
