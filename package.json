{
  "name": "ghost-grader",
  "private": true,
  "version": "0.1.0",
  "description": "Browser-native grading copilot that detects intra-rater drift inside the LMS",
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/api --filter ./apps/mock-lms dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "e2e": "pnpm --filter @gg/extension e2e"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=20.19" }
}
