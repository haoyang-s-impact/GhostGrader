{
  "name": "ghost-grader",
  "private": true,
  "version": "0.1.0",
  "description": "Grading copilot that sits alongside the LMS: grade question/answer pairs against each question's rubric and catch inconsistent grading",
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/api --filter ./apps/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "e2e": "pnpm --filter @gg/web e2e"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=20.19" }
}
